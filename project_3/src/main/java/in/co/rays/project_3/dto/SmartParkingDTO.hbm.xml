<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

	<class name="SmartParkingDTO" table="ST_SMART_PARKING">

		<id name="slotId" type="int">
			<column name="SLOT_ID" />
			<generator class="increment" />
		</id>
		<property name="slotId" type="int">
			<column name="SLOTID" />
		</property>
		<property name="vehicalNumber" type="java.lang.String">
			<column name="VEHICALNUMBER" />
		</property>
		<property name="vehicalType" type="java.lang.String">
			<column name="VEHICALTYPE" />
		</property>
		<property name="occupied" type="boolean">
			<column name="OCCUPIED" />
		</property>
	</class>
</hibernate-mapping>
